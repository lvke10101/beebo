</button>
<!-- Library -->
<button class="flex flex-col items-center justify-center space-y-1 text-gray-400 hover:text-gray-600 w-12">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="text-[10px] font-medium">Library</span>
</button>
<!-- Circle -->
<button class="flex flex-col items-center justify-center space-y-1 text-gray-400 hover:text-gray-600 w-12">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="text-[10px] font-medium">Circle</span>
</button>
<!-- Profile -->
<button id="nav-profile" class="flex flex-col items-center justify-center space-y-1 w-12" onclick="showView('profile')">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="text-[10px] font-medium">Profile</span>
</button>
</nav>
<!-- END: Bottom Navigation -->

<!-- BEGIN: Comment Overlay -->
<!-- BEGIN: Global Toast -->
<div id="app-toast" class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-[60] bg-gray-900 text-white text-[14px] font-medium px-4 py-3 rounded-xl shadow-[0_8px_24px_rgba(0,0,0,0.2)] max-w-[90%] text-center" role="status" aria-live="polite"></div>
<!-- END: Global Toast -->

<!-- BEGIN: Delete Post Confirm Dialog -->
<!-- Global (outside all .view-section containers) so it can be triggered
     from the feed and the comment overlay, not just while composing. -->
<div id="delete-post-backdrop" class="hidden fixed inset-0 z-[70] bg-black/30"></div>
<div id="delete-post-dialog" class="hidden fixed inset-0 z-[70] flex items-center justify-center px-8" role="alertdialog" aria-modal="true" aria-labelledby="delete-post-dialog-title">
	<div class="bg-white rounded-2xl shadow-[0_8px_24px_rgba(0,0,0,0.16)] w-full max-w-[320px] p-5 text-center">
		<h3 id="delete-post-dialog-title" class="text-[16px] font-semibold text-gray-900 mb-1">Delete post?</h3>
		<p class="text-sm text-gray-500 mb-5">This can't be undone. Your post will be permanently removed.</p>
		<div class="flex flex-col gap-2">
			<button type="button" id="delete-post-confirm-btn" class="w-full py-3 rounded-xl bg-brand-red text-white font-semibold text-[15px] hover:bg-red-700 transition-colors">Delete</button>
			<button type="button" class="w-full py-3 text-gray-500 font-medium text-[15px]" onclick="closeDeletePostDialog()">Cancel</button>
		</div>
	</div>
</div>
<!-- END: Delete Post Confirm Dialog -->

<div id="comment-overlay" class="hidden fixed inset-0 z-50 bg-black/50" style="backdrop-filter: blur(4px);">
	<div class="overlay-content w-full max-w-[430px] mx-auto bg-white flex flex-col">
		<!-- Header -->
		<header class="relative flex items-center justify-between px-5 py-4 border-b border-gray-100 shrink-0">
			<button id="close-overlay-btn" class="p-2 -ml-2 text-gray-900 focus:outline-none" aria-label="Close">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
			<button id="overlay-menu-btn" aria-label="More options" aria-haspopup="true" aria-expanded="false" class="p-2 -mr-2 text-gray-900 focus:outline-none active:scale-95 transition-transform duration-100" onclick="toggleOverlayPostMenu()">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M6.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM12.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM18.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>

			<!-- Post options popover (mirrors the feed card's post-menu-sheet actions, plus Delete) -->
			<div id="overlay-menu-backdrop" class="hidden fixed inset-0 z-40" onclick="closeOverlayPostMenu()"></div>
			<div id="overlay-menu-popover" class="hidden absolute z-50 top-[52px] right-4 bg-white rounded-2xl shadow-[0_8px_24px_rgba(0,0,0,0.16)] border border-gray-100 py-2 w-52 origin-top-right">
				<div class="absolute -top-[5px] right-5 w-3 h-3 bg-white border-t border-l border-gray-100 rotate-45"></div>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="save">
					<i class="fa-regular fa-bookmark text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Save post</span>
				</button>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="share">
					<i class="fa-solid fa-arrow-up-from-bracket text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Share post</span>
				</button>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="copy-link">
					<i class="fa-solid fa-link text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Copy link</span>
				</button>
				<div class="border-t border-gray-100 my-1"></div>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="hide">
					<i class="fa-regular fa-eye-slash text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Hide post</span>
				</button>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="not-interested">
					<i class="fa-solid fa-ban text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Not interested</span>
				</button>
				<div class="border-t border-gray-100 my-1"></div>
				<button type="button" class="overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="report">
					<i class="fa-regular fa-flag text-gray-500 w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-gray-800">Report post</span>
				</button>
				<div id="overlay-menu-delete-divider" class="hidden border-t border-gray-100 my-1"></div>
				<button type="button" id="overlay-menu-delete-btn" class="hidden overlay-menu-action group w-full flex items-center gap-3 px-4 py-2.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="delete">
					<i class="fa-regular fa-trash-can text-brand-red w-5 text-center text-[15px] transition-transform duration-150 group-active:scale-90"></i>
					<span class="text-[14px] text-brand-red font-medium">Delete post</span>
				</button>
			</div>
		</header>

		<!-- Original Post -->
		<article id="overlay-post" class="px-5 pt-2 pb-6 border-b border-gray-100 shrink-0">
			<!-- Author Info -->
			<div class="flex items-center gap-3 mb-4">
				<img id="overlay-post-avatar" alt="" class="w-12 h-12 rounded-full bg-gray-200 object-cover shrink-0" src=""/>
				<div>
					<h2 id="overlay-post-author" class="text-[17px] font-bold leading-tight"></h2>
					<p id="overlay-post-handle" class="text-[15px] text-gray-500 mt-0.5"></p>
				</div>
			</div>
			<!-- Post Images -->
			<div id="overlay-post-images" class="hidden"></div>
			<!-- Post Content -->
			<p id="overlay-post-content" class="text-[17px] leading-[1.6] text-gray-800 mb-4"></p>
			<div class="flex items-center gap-1.5 text-gray-500 mb-4">
				<svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span id="overlay-post-time" class="text-[15px]"></span>
			</div>
			<!-- Stats Row -->
			<div class="flex items-center gap-6 text-gray-700">
				<div class="flex items-center gap-2">
					<span class="like-icon-wrapper">
						<svg class="w-5 h-5 heart-outline" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
						<svg class="w-5 h-5 text-brand-red heart-filled absolute inset-0" fill="currentColor" stroke="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"></path>
						</svg>
					</span>
					<span id="overlay-post-likes" class="text-[15px] font-medium"></span>
				</div>
				<div class="flex items-center gap-2">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
					<span id="overlay-post-comments" class="text-[15px] font-medium"></span>
				</div>
			</div>
		</article>

		<!-- Replies Section (scrollable) -->
		<section class="flex-1 overlay-replies-section">
			<h3 id="overlay-replies-heading" class="px-5 pt-6 pb-5 text-[17px] font-bold sticky top-0 bg-white">Replies (0)</h3>
			<div id="overlay-replies-list" class="px-5 pb-4">
				<!-- Loading state -->
				<div id="overlay-loading" class="text-center py-8 text-gray-400">
					<svg class="animate-spin h-8 w-8 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<p class="text-sm">Loading comments...</p>
				</div>
				<!-- Empty state -->
				<div id="overlay-empty" class="hidden text-center py-8 text-gray-400 text-sm">
					No comments yet. Be the first to reply!
				</div>
				<!-- Error state -->
				<div id="overlay-error" class="hidden text-center py-8 text-red-500 text-sm"></div>
				<!-- Comments container -->
				<div id="overlay-comments-container"></div>
			</div>
		</section>

		<!-- Fixed Reply Input Bar -->
		<div class="shrink-0 p-4 bg-white/95 backdrop-blur-md border-t border-gray-100">
			<!-- Replying-to context chip: shown only after tapping a specific
			     comment's Reply action. Flat comment model (no parent_id on
			     the backend) so this is a mention-style convenience, not real
			     threading — see startReplyTo(). -->
			<div id="overlay-reply-context" class="hidden items-center justify-between mb-2 pl-1">
				<span class="text-[13px] text-gray-500">Replying to <span id="overlay-reply-context-handle" class="text-gray-700 font-medium"></span></span>
				<button type="button" id="overlay-reply-context-cancel" class="p-1 -mr-1 text-gray-400 hover:text-gray-600 focus:outline-none" aria-label="Cancel reply">
					<i class="fa-solid fa-xmark text-[13px]"></i>
				</button>
			</div>
			<div class="relative flex items-center">
				<input id="overlay-reply-input" class="w-full h-[52px] pl-5 pr-14 rounded-full border border-gray-200 bg-gray-50/50 text-[16px] focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red transition-shadow" placeholder="Post a reply..." type="text" maxlength="1000"/>
				<button id="overlay-reply-send-btn" class="absolute right-1.5 w-[42px] h-[42px] bg-brand-red rounded-full flex items-center justify-center text-white focus:outline-none hover:bg-red-700 transition-colors disabled:opacity-40 disabled:pointer-events-none" disabled aria-disabled="true">
					<svg id="overlay-reply-send-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
					</svg>
					<svg id="overlay-reply-send-icon" class="w-5 h-5 ml-1" fill="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z"></path>
					</svg>
				</button>
			</div>
			<div class="flex items-center justify-between mt-1.5 px-1 min-h-[16px]">
				<div id="overlay-reply-error" class="hidden text-sm text-red-600"></div>
				<span id="overlay-reply-counter" class="hidden ml-auto text-[12px] text-gray-400 tabular-nums">0/1000</span>
			</div>
		</div>
	</div>
</div>
<!-- END: Comment Overlay -->

<!-- BEGIN: Post Action Menu Bottom Sheet -->
<div id="post-menu-backdrop" class="hidden fixed inset-0 z-40 bg-black/20 transition-opacity" onclick="closePostMenu()"></div>
<div id="post-menu-sheet" class="hidden fixed left-0 right-0 bottom-0 z-50 bg-white rounded-t-[24px] shadow-[0_-8px_24px_rgba(0,0,0,0.12)] pt-2 pb-6 max-w-[430px] mx-auto transition-transform origin-bottom" role="dialog" aria-modal="true" aria-label="Post options">
	<div class="w-12 h-1 bg-gray-200 rounded-full mx-auto mb-2"></div>
	<div class="py-2">
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="save">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-regular fa-bookmark text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Save post</span>
		</button>
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="share">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-solid fa-arrow-up-from-bracket text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Share post</span>
		</button>
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="copy-link">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-solid fa-link text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Copy link</span>
		</button>
	</div>
	<div class="border-t border-gray-100 py-2">
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="hide">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-regular fa-eye-slash text-[18px]"></i></span>
			<span>
				<span class="block text-[15px] font-medium text-gray-900">Hide post</span>
				<span class="block text-[13px] text-gray-400">See fewer posts like this</span>
			</span>
		</button>
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="not-interested">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-solid fa-ban text-[18px]"></i></span>
			<span>
				<span class="block text-[15px] font-medium text-gray-900">Not interested</span>
				<span class="block text-[13px] text-gray-400">Don't show posts like this</span>
			</span>
		</button>
	</div>
	<div class="border-t border-gray-100 py-2">
		<button type="button" class="post-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50" data-action="report">
			<span class="post-menu-icon w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-regular fa-flag text-[18px]"></i></span>
			<span>
				<span class="block text-[15px] font-medium text-gray-900">Report post</span>
				<span class="block text-[13px] text-gray-400">Report this to the admins</span>
			</span>
		</button>
	</div>
	<div class="border-t border-gray-100 pt-2 px-3">
		<button type="button" id="post-menu-cancel-btn" class="w-full py-3.5 text-center text-[15px] font-semibold text-gray-500 rounded-xl transition-colors duration-100 active:bg-gray-100">Cancel</button>
	</div>
</div>
<!-- END: Post Action Menu Bottom Sheet -->

<!-- BEGIN: Comment Action Menu Bottom Sheet -->
<div id="comment-menu-backdrop" class="hidden fixed inset-0 z-40 bg-black/20 transition-opacity" onclick="closeCommentMenu()"></div>
<div id="comment-menu-sheet" class="hidden fixed left-0 right-0 bottom-0 z-50 bg-white rounded-t-[24px] shadow-[0_-8px_24px_rgba(0,0,0,0.12)] pt-2 pb-6 max-w-[430px] mx-auto transition-transform origin-bottom" role="dialog" aria-modal="true" aria-label="Comment options">
	<div class="w-12 h-1 bg-gray-200 rounded-full mx-auto mb-2"></div>
	<div class="py-2">
		<button type="button" id="comment-menu-reply-btn" class="comment-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50">
			<span class="w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-solid fa-reply text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Reply</span>
		</button>
		<button type="button" id="comment-menu-copy-btn" class="comment-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50">
			<span class="w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-solid fa-copy text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Copy text</span>
		</button>
	</div>
	<!-- Report shows for other people's comments; Delete shows for your own.
	     Mutually exclusive, toggled in openCommentMenu(). -->
	<div id="comment-menu-report-group" class="border-t border-gray-100 py-2">
		<button type="button" id="comment-menu-report-btn" class="comment-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50">
			<span class="w-6 flex items-center justify-center text-gray-700 transition-transform duration-150 group-active:scale-90"><i class="fa-regular fa-flag text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-gray-900">Report comment</span>
		</button>
	</div>
	<div id="comment-menu-delete-group" class="hidden border-t border-gray-100 py-2">
		<button type="button" id="comment-menu-delete-btn" class="comment-menu-action group w-full flex items-center gap-4 px-5 py-3.5 text-left transition-colors duration-100 active:bg-gray-50">
			<span class="w-6 flex items-center justify-center text-brand-red transition-transform duration-150 group-active:scale-90"><i class="fa-regular fa-trash-can text-[18px]"></i></span>
			<span class="text-[15px] font-medium text-brand-red">Delete comment</span>
		</button>
	</div>
	<div class="border-t border-gray-100 pt-2 px-3">
		<button type="button" id="comment-menu-cancel-btn" class="w-full py-3.5 text-center text-[15px] font-semibold text-gray-500 rounded-xl transition-colors duration-100 active:bg-gray-100">Cancel</button>
	</div>
</div>
<!-- END: Comment Action Menu Bottom Sheet -->

<!-- BEGIN: Delete Comment Confirm Dialog -->
<div id="delete-comment-backdrop" class="hidden fixed inset-0 z-[70] bg-black/30"></div>
<div id="delete-comment-dialog" class="hidden fixed inset-0 z-[70] flex items-center justify-center px-8" role="alertdialog" aria-modal="true" aria-labelledby="delete-comment-dialog-title">
	<div class="bg-white rounded-2xl shadow-[0_8px_24px_rgba(0,0,0,0.16)] w-full max-w-[320px] p-5 text-center">
		<h3 id="delete-comment-dialog-title" class="text-[16px] font-semibold text-gray-900 mb-1">Delete comment?</h3>
		<p class="text-sm text-gray-500 mb-5">This can't be undone. Your comment will be permanently removed.</p>
		<div class="flex flex-col gap-2">
			<button type="button" id="delete-comment-confirm-btn" class="w-full py-3 rounded-xl bg-brand-red text-white font-semibold text-[15px] hover:bg-red-700 transition-colors">Delete</button>
			<button type="button" class="w-full py-3 text-gray-500 font-medium text-[15px]" onclick="closeDeleteCommentDialog()">Cancel</button>
		</div>
	</div>
</div>
<!-- END: Delete Comment Confirm Dialog -->

